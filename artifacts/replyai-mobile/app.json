{
  "expo": {
    "name": "ReplyAI",
    "slug": "replyai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "replyai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.replyai.mobile",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "ReplyAI sends you notifications for important emails and replies.",
        "NSCalendarsUsageDescription": "ReplyAI accesses your calendar to help schedule meetings from emails.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "ReplyAI creates calendar events from emails.",
        "NSRemindersUsageDescription": "ReplyAI may create reminders for follow-up emails.",
        "NSMicrophoneUsageDescription": "ReplyAI uses your microphone to transcribe voice messages into text for the AI agent.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.replyai.mobile",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "37a94f7d-4f44-4888-9071-8794847e2d9f"
      }
    },
    "owner": "rishinair"
  }
}
